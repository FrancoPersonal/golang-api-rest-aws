                "exec": [
                  "// Overrides jwt_token with an expired but correctly signed token.",
                  "const secret = pm.environment.get('jwt_secret') || 'dev-secret';",
                  "",
                  "function b64url(s) {",
                  "    return btoa(s).replace(/[+]/g, '-').replace(/[/]/g, '_').replace(/[=]/g, '');",
                  "}",
                  "",
                  "const hdr     = b64url(JSON.stringify({ alg: 'HS256', typ: 'JWT' }));",
                  "const pay     = b64url(JSON.stringify({ exp: 1000, iat: 500 }));",
                  "const signing = hdr + '.' + pay;",
                  "const hash    = CryptoJS.HmacSHA256(signing, secret);",
                  "const sig     = CryptoJS.enc.Base64.stringify(hash)",
                  "                    .replace(/[+]/g, '-').replace(/[/]/g, '_').replace(/[=]/g, '');",
                  "",
                  "pm.environment.set('jwt_token', signing + '.' + sig);"
                ]
              }
