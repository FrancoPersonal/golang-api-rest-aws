    "name": "Cauciones API — Integration Tests (Floci)",
    "description": "Integration test suite for the Cauciones API running on the Floci local AWS emulator. Covers authentication, input validation, and business flows for POST and GET /cauciones.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "// Generates a fresh valid HS256 JWT before every request.",
          "const secret = pm.environment.get('jwt_secret') || 'dev-secret';",
          "const now = Math.floor(Date.now() / 1000);",
          "",
          "function b64url(s) {",
          "    return btoa(s).replace(/[+]/g, '-').replace(/[/]/g, '_').replace(/[=]/g, '');",
          "}",
          "",
          "const hdr     = b64url(JSON.stringify({ alg: 'HS256', typ: 'JWT' }));",
          "const pay     = b64url(JSON.stringify({ exp: now + 3600, iat: now }));",
          "const signing = hdr + '.' + pay;",
          "const hash    = CryptoJS.HmacSHA256(signing, secret);",
          "const sig     = CryptoJS.enc.Base64.stringify(hash)",
          "                    .replace(/[+]/g, '-').replace(/[/]/g, '_').replace(/[=]/g, '');",
          "",
          "pm.environment.set('jwt_token', signing + '.' + sig);"
        ]
      }
    }
  ],
