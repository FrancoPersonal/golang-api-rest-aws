{
  "_postman_variable_scope": "environment",
  "id": "floci-local-env",
  "name": "Floci Local",
  "values": [
    {
      "key": "base_url",
      "value": "",
      "type": "default",
      "enabled": true,
      "description": "Set automatically by run_integration_tests.sh via --env-var"
    },
    {
      "key": "jwt_secret",
      "value": "dev-secret",
      "type": "default",
      "enabled": true,
      "description": "Must match JWT_SECRET used when deploying Lambdas to Floci"
    },
    {
      "key": "jwt_token",
      "value": "",
      "type": "default",
      "enabled": true,
      "description": "Auto-generated by the collection pre-request script"
    },
    {
      "key": "test_numero",
      "value": "",
      "type": "default",
      "enabled": true,
      "description": "Auto-generated unique numero for each test run"
    },
    {
      "key": "created_id",
      "value": "",
      "type": "default",
      "enabled": true,
      "description": "Populated after crear caución válida to verify GET /cauciones"
    }
  ]
}
